{
  "name": "easython",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --import ./scripts/demo-env.ts ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3102",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:compiler": "node scripts/check-react-compiler.ts",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run check:compiler && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2"
  }
}
